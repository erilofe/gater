# Application Server
PORT=8080
GIN_MODE=debug

# Services URLs
# In Docker, these will be overridden by service names (e.g. http://user:8081)
USER_SERVICE_URL=http://localhost:8081
POST_SERVICE_URL=http://localhost:8082

# Circuit Breaker Settings
# MaxRequests: Number of requests allowed in half-open state
CB_MAX_REQUESTS=1
# Interval: Time (e.g., 10s, 1m) to clear internal counts
CB_INTERVAL=10s
# Timeout: Time (e.g., 30s, 1m) the breaker stays open before trying half-open
CB_TIMEOUT=30s
